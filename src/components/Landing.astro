---
// The product site's sales page, rendered at the root ONLY when IS_PRODUCT_SITE is
// true (see src/pages/index.astro). It's a full standalone document on purpose:
// Layout.astro carries the portfolio's theme, og:image and description from
// content.json, none of which belong on a marketing page.
import { withBase } from '../portfolio/types';
import { currentPrice, currentPriceText, monthlyPriceText, pricing } from '../lib/pricing';
import { exampleSites } from '../lib/examples';
import { AVAILABLE_STARTERS, starterShotUrl } from '../editor/lib/templates';
import Favicons from './Favicons.astro';

const base = import.meta.env.BASE_URL;
const editorUrl = withBase(base, 'editor/');
const lifetimeCheckoutEntryUrl = `${editorUrl}?unlock=1&plan=lifetime`;
const monthlyCheckoutEntryUrl = `${editorUrl}?unlock=1&plan=monthly`;
const templatesUrl = withBase(base, 'templates');
const faqUrl = withBase(base, 'faq');
const guideUrl = withBase(base, 'guide');
const termsUrl = withBase(base, 'terms');
const privacyUrl = withBase(base, 'privacy');
const squarespaceAlternativeUrl = withBase(base, 'learn/squarespace-alternative-for-artists');
const noSubscriptionUrl = withBase(base, 'learn/portfolio-website-without-subscription');
const artPortfolioGuideUrl = withBase(base, 'learn/how-to-make-an-art-portfolio-site');
const brandLockup = withBase(base, 'assets/brand/hangwork-lockup.svg');
const title = 'Portfolio website builder for artists — Hangwork';
const description =
	`Build an art portfolio website with a visual editor. Choose ${currentPriceText} once for lifetime access or ${monthlyPriceText} per month for hosted access.`;
const canonicalUrl = Astro.site ? new URL(withBase(base), Astro.site).href : undefined;
// The landing shows four of the catalog; /templates shows all of them. Cards are
// the templates' own generated screenshots (spec 37B).
const featuredTemplates = AVAILABLE_STARTERS.slice(0, 4).map((starter) => ({
	id: starter.id,
	name: starter.name,
	tagline: starter.tagline,
	shot: starterShotUrl(starter.id),
	href: `${editorUrl}?template=${starter.id}`,
}));
const madeWith = exampleSites[0];
const ogImageUrl = Astro.site
	? new URL(withBase(base, 'assets/brand/og-card.png'), Astro.site).href
	: undefined;
const applicationLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Hangwork',
	applicationCategory: 'DesignApplication',
	operatingSystem: 'Web browser',
	description,
	offers: [
		{
			'@type': 'Offer',
			name: 'Hangwork lifetime access',
			price: currentPrice,
			priceCurrency: 'USD',
			url: canonicalUrl,
		},
		{
			'@type': 'Offer',
			name: 'Hangwork monthly access',
			price: pricing.monthlyPrice,
			priceCurrency: 'USD',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: pricing.monthlyPrice,
				priceCurrency: 'USD',
				billingDuration: 'P1M',
			},
			url: canonicalUrl,
		},
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<Favicons base={base} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Hangwork" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
		{ogImageUrl && <meta property="og:image:width" content="1200" />}
		{ogImageUrl && <meta property="og:image:height" content="630" />}
		{ogImageUrl && (
			<meta property="og:image:alt" content="Hang your work. Own it forever. — hangwork.art" />
		)}
		<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(applicationLd)} is:inline />
	</head>
	<body>
		<header class="topbar">
			<a class="brand" href={withBase(base)} aria-label="Hangwork home">
				<img class="brand-logo" src={brandLockup} alt="Hangwork" />
			</a>
			<nav class="topnav">
				<a href="#how">How it works</a>
				<a href={templatesUrl}>Templates</a>
				<a href="#pricing">Pricing</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<!-- "Own it forever" links to its proof — what happens if Hangwork shuts down. -->
					<h1>
						Hang your work.<br /><a
							class="own-link"
							href={`${faqUrl}#if-hangwork-shuts-down`}
							title="What happens if Hangwork shuts down">Own it forever.</a
						>
					</h1>
					<p class="lede">
						A portfolio site for visual artists. Start monthly or pay once for lifetime access and
						portable site files.
					</p>
					<div class="hero-actions">
						<div class="primary-action">
							<a class="btn btn-primary" href={editorUrl}>Hang your first piece</a>
							<p class="hero-price">
								<span class="hero-current-price">{currentPriceText} once</span>
								<span>or {monthlyPriceText}/month.</span>
							</p>
						</div>
						<a class="btn btn-secondary" href={templatesUrl}>Browse templates</a>
					</div>
				</div>
				<!-- The logo mark at wall scale: nail, wire, and a frame the artist fills.
				     Pure CSS motion — a slow pendulum sway and a timed crossfade, no script. -->
				<div class="hero-hang" aria-hidden="true">
					<div class="hang-swing">
						<svg class="hang-rig" viewBox="0 0 80 26" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M40 4 L16 26 M40 4 L64 26" stroke="var(--ink)" stroke-width="0.9" stroke-linecap="round" />
							<circle cx="40" cy="4" r="1.5" fill="var(--klein)" />
						</svg>
						<div class="hang-frame">
							<img src={withBase(base, 'assets/brand/hero/hero-01.jpg')} alt="" decoding="async" />
							<img src={withBase(base, 'assets/brand/hero/hero-02.jpg')} alt="" decoding="async" />
							<img src={withBase(base, 'assets/brand/hero/hero-03.jpg')} alt="" decoding="async" />
							<img src={withBase(base, 'assets/brand/hero/hero-04.jpg')} alt="" decoding="async" />
							<img src={withBase(base, 'assets/brand/hero/hero-05.jpg')} alt="" decoding="async" />
						</div>
					</div>
				</div>
			</section>

			<section class="band" id="how">
				<h2>How it works</h2>
				<ol class="steps">
					<li>
						<span class="step-num">01</span>
						<p>Build your wall in the browser. Add your pieces, arrange them, watch the preview.</p>
					</li>
					<li>
						<span class="step-num">02</span>
						<p>Claim your space — a free account where your site is stored, in your name.</p>
					</li>
					<li>
						<span class="step-num">03</span>
						<p>Publish. Your site goes live at its own address. Come back anytime to rehang.</p>
					</li>
				</ol>
			</section>

			<section class="band" id="templates">
				<h2>Templates</h2>
				<p class="band-lede">Finished designs to start from — your work replaces the samples, and you can change design whenever you like.</p>
				<div class="template-list">
					{featuredTemplates.map((template) => (
						<article class="template-card">
							<a class="template-preview" href={template.href}>
								{template.shot && (
									<img
										src={template.shot}
										alt={`The ${template.name} template's home page`}
										width="720"
										height="450"
										loading="lazy"
										decoding="async"
									/>
								)}
							</a>
							<div class="template-copy">
								<strong>{template.name}</strong>
								<p>{template.tagline}</p>
							</div>
						</article>
					))}
				</div>
				<p class="band-more"><a href={templatesUrl}>Browse all templates</a></p>
				<p class="made-with">
					Made with Hangwork:{' '}
					<a href={madeWith.url} target="_blank" rel="noreferrer">
						{madeWith.domain}<span aria-hidden="true">↗</span>
					</a>
				</p>
			</section>

			<section class="band" id="guides">
				<h2>Guides for artists</h2>
				<div class="guide-links">
					<a href={squarespaceAlternativeUrl}>
						<strong>A Squarespace alternative for artists</strong>
						<span>Compare the cost model, ownership, portfolio tools, and tradeoffs.</span>
					</a>
					<a href={noSubscriptionUrl}>
						<strong>Portfolio website without a subscription</strong>
						<span>See what one-time pricing includes and which optional costs remain.</span>
					</a>
					<a href={artPortfolioGuideUrl}>
						<strong>How to make an art portfolio site</strong>
						<span>Choose the work, prepare images, structure pages, write, test, and publish.</span>
					</a>
				</div>
			</section>

			<section class="band" id="questions">
				<h2>Common questions</h2>
				<div class="faq-teaser">
					<a href={`${faqUrl}#if-hangwork-shuts-down`}>What happens if Hangwork shuts down?</a>
					<a href={`${faqUrl}#who-owns-my-work`}>Who owns my images and my site?</a>
					<a href={`${faqUrl}#can-i-leave`}>Can I leave?</a>
				</div>
				<p class="band-more"><a href={faqUrl}>All questions</a></p>
			</section>

			<section class="band pricing" id="pricing">
				<div class="pricing-copy">
					<h2>Choose how you pay</h2>
					<p class="included">
						Both plans include the editor, a yourname.hangwork.art address, publishing, custom domains,
						and future editor updates.
					</p>
					<div class="pricing-options">
						<article class="pricing-option featured">
							<p class="pricing-option-label">Lifetime access</p>
							<p class="price-lockup">
								<strong>{currentPriceText}</strong>
								<span>once</span>
							</p>
							<p>Every feature, including site and backup downloads. Pay once, keep access, and keep your site live.</p>
							<a class="btn btn-primary" href={lifetimeCheckoutEntryUrl}>
								Choose lifetime — {currentPriceText}
							</a>
						</article>
						<article class="pricing-option">
							<p class="pricing-option-label">Monthly access</p>
							<p class="price-lockup">
								<strong>{monthlyPriceText}</strong>
								<span>per month</span>
							</p>
							<p>
								First {pricing.monthlyTrialDays} days free — cancel before they end and pay nothing.
								Then everything except downloads; your published site goes offline if the
								subscription ends.
							</p>
							<p class="upgrade-credit">Upgrade later and get your first {monthlyPriceText} payment off lifetime access.</p>
							<a class="btn btn-secondary" href={monthlyCheckoutEntryUrl}>
								Go live free for {pricing.monthlyTrialDays} days
							</a>
						</article>
					</div>
					<p class="paynow-refund">{pricing.refundDays}-day refund, no questions asked.</p>
					<p class="pricing-comparison">
						Prefer to build first? <a href={editorUrl}>The editor and preview are free</a>; choose a
						paid plan only when you publish.
						<a href={squarespaceAlternativeUrl}> Compare the tradeoffs.</a>
					</p>
					<p class="ownership-note">
						<a href={`${faqUrl}#if-hangwork-shuts-down`}>
							Your site lives in an account you own — here's what that means.
						</a>
					</p>
				</div>
			</section>
		</main>

		<footer class="footer">
			<a class="brand" href={withBase(base)} aria-label="Hangwork home">
				<img class="brand-logo" src={brandLockup} alt="Hangwork" />
			</a>
			<nav>
				<a href={templatesUrl}>Templates</a>
				<a href={artPortfolioGuideUrl}>Portfolio guide</a>
				<a href={guideUrl}>Setup guide</a>
				<a href={faqUrl}>Questions</a>
				<a href={termsUrl}>Terms</a>
				<a href={privacyUrl}>Privacy</a>
				<a href={editorUrl}>Editor</a>
				<a href="mailto:william.stroud100@gmail.com">Support</a>
			</nav>
			<span class="footer-note">Payments, tax, and refunds are handled by the merchant of record shown at checkout.</span>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--paper: #faf8f5;
		--ink: #1a1a1a;
		--ink-soft: #6b6963;
		--klein: #002fa7;
		--klein-dark: #00248a;
		--wall-2: #ddd9d0;
		--wall-3: #e5e1da;
	}
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial,
			sans-serif;
		font-size: 16px;
		font-weight: 400;
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}
	:is(a, button):focus-visible {
		outline: 2px solid var(--klein);
		outline-offset: 3px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.brand-logo {
		display: block;
		width: auto;
		height: 50px;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
		padding: 28px 32px;
	}
	.topnav {
		display: flex;
		align-items: baseline;
		gap: 28px;
	}
	.topnav a {
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 15px;
		white-space: nowrap;
	}
	.topnav a:hover {
		color: var(--ink);
	}

	.btn {
		display: inline-block;
		border-radius: 4px;
		padding: 11px 22px;
		font-size: 15px;
		font-weight: 500;
		text-decoration: none;
		border: 1px solid transparent;
	}
	.btn-primary {
		background: var(--klein);
		color: var(--paper);
	}
	.btn-primary:hover {
		background: var(--klein-dark);
	}
	.btn-secondary {
		background: transparent;
		border-color: var(--wall-2);
		color: var(--ink);
	}
	.btn-secondary:hover {
		background: var(--wall-3);
	}

	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 32px;
	}

	.hero {
		min-height: 68vh;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
		align-items: center;
		gap: 24px 64px;
		padding: 48px 0 24px;
	}

	/* ---- The hanging frame: the logo mark at wall scale ---- */
	.hero-hang {
		display: flex;
		justify-content: center;
		/* Hang the frame a touch above the copy's centerline. */
		margin-top: -48px;
	}
	.hang-swing {
		width: 100%;
		max-width: 400px;
		/* Pivot on the nail. In frame-width units the nail center sits 4 down and the
		   whole assembly (rig 26 + frame 52) is 78 tall → 4/78 ≈ 5.13% from the top. */
		transform-origin: 50% 5.13%;
		animation: hang-sway 9s ease-in-out infinite;
	}
	.hang-rig {
		display: block;
		width: 100%;
		height: auto;
	}
	.hang-frame {
		position: relative;
		aspect-ratio: 80 / 52;
		border: 9px solid var(--ink);
		background: var(--paper);
	}
	.hang-frame img {
		position: absolute;
		inset: 22px;
		width: calc(100% - 44px);
		height: calc(100% - 44px);
		object-fit: contain;
		opacity: 0;
		animation: hang-cycle 25s linear infinite;
	}
	.hang-frame img:nth-child(2) {
		animation-delay: 5s;
	}
	.hang-frame img:nth-child(3) {
		animation-delay: 10s;
	}
	.hang-frame img:nth-child(4) {
		animation-delay: 15s;
	}
	.hang-frame img:nth-child(5) {
		animation-delay: 20s;
	}
	@keyframes hang-sway {
		0%,
		100% {
			transform: rotate(0deg);
		}
		25% {
			transform: rotate(2.1deg);
		}
		75% {
			transform: rotate(-2.1deg);
		}
	}
	/* Each image owns a fifth of the 25s cycle: 1s fade in, 4s hold, 1s fade out. */
	@keyframes hang-cycle {
		0% {
			opacity: 0;
		}
		4% {
			opacity: 1;
		}
		20% {
			opacity: 1;
		}
		24% {
			opacity: 0;
		}
		100% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hang-swing {
			animation: none;
		}
		.hang-frame img {
			animation: none;
		}
		.hang-frame img:first-child {
			opacity: 1;
		}
	}
	.hero h1 {
		font-size: clamp(34px, 6vw, 56px);
		font-weight: 500;
		line-height: 1.12;
		letter-spacing: -0.02em;
		margin: 0 0 24px;
	}
	/* Stays part of the headline — ink, not Klein — but underlines on hover/focus to
	   signal it leads to the proof (the FAQ's "if Hangwork shuts down" answer). */
	.own-link {
		color: inherit;
		text-decoration: none;
	}
	.own-link:hover,
	.own-link:focus-visible {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 6px;
	}
	.lede {
		font-size: 17px;
		color: var(--ink-soft);
		margin: 0 0 36px;
		max-width: 30em;
	}
	.hero-actions {
		display: flex;
		align-items: flex-start;
		gap: 16px;
		flex-wrap: wrap;
	}
	.primary-action {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
	}
	.hero-price {
		display: flex;
		align-items: baseline;
		gap: 5px;
		margin: 0;
		font-size: 13px;
		color: var(--ink-soft);
	}
	.hero-price del {
		color: var(--ink-soft);
		text-decoration-thickness: 1px;
	}
	.hero-current-price {
		color: var(--ink);
	}

	.band {
		padding: 112px 0;
		border-top: 1px solid var(--wall-2);
	}
	.band h2 {
		font-size: 15px;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--ink-soft);
		margin: 0 0 32px;
	}
	.band-lede {
		font-size: 17px;
		color: var(--ink);
		margin: 0 0 32px;
		max-width: 34em;
	}
	.guide-links {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}
	.guide-links a {
		display: flex;
		flex-direction: column;
		gap: 10px;
		min-height: 150px;
		padding: 22px;
		border: 1px solid var(--wall-2);
		border-radius: 4px;
		color: var(--ink);
		text-decoration: none;
	}
	.guide-links a:hover {
		background: var(--wall-3);
	}
	.guide-links strong {
		font-weight: 500;
		line-height: 1.4;
	}
	.guide-links span {
		color: var(--ink-soft);
		font-size: 13px;
		line-height: 1.55;
	}

	.template-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px 32px;
	}
	.template-card {
		min-width: 0;
	}
	/* The work is presented flat, as on a wall: a hairline border, no shadow. */
	.template-preview {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border: 1px solid var(--wall-2);
		border-radius: 3px;
		background: var(--wall-3);
	}
	.template-preview img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
	}
	.template-preview:hover,
	.template-preview:focus-visible {
		border-color: var(--ink);
	}
	.template-copy {
		padding-top: 16px;
	}
	.template-copy strong {
		display: block;
		margin: 0 0 5px;
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.template-copy p {
		max-width: 29rem;
		margin: 0;
		color: var(--ink-soft);
		font-size: 14px;
		line-height: 1.55;
	}
	.made-with {
		margin: 18px 0 0;
		color: var(--ink-soft);
		font-size: 14px;
	}
	.made-with a {
		color: var(--ink);
		text-decoration: none;
	}
	.made-with a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.made-with span {
		color: var(--klein);
	}
	.site-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		flex-shrink: 0;
		color: var(--ink);
		font-size: 14px;
		text-decoration: none;
		white-space: nowrap;
	}
	.site-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.site-link span {
		color: var(--klein);
	}

	.faq-teaser {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
	}
	.faq-teaser a {
		color: var(--ink);
		font-size: 17px;
		text-decoration: none;
	}
	.faq-teaser a:hover,
	.faq-teaser a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.band-more {
		margin: 32px 0 0;
		font-size: 14px;
	}
	.band-more a {
		color: var(--ink-soft);
		text-decoration: none;
	}
