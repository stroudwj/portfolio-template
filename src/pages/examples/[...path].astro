---
// /examples moved to /templates (BACKLOG spec 37C). The old address is kept as a
// redirect so links already in the wild — and anything indexed — still land
// somewhere real instead of on the 404 page. Nothing user-facing says "example
// sites" any more; this file exists only so that rename costs no visitor.
import { withBase } from '../../portfolio/types';
import { IS_PRODUCT_SITE } from '../../lib/productSite';
import Favicons from '../../components/Favicons.astro';

export function getStaticPaths() {
	if (!IS_PRODUCT_SITE) return [];
	return [{ params: { path: undefined } }];
}

const base = import.meta.env.BASE_URL;
const templatesUrl = withBase(base, 'templates');
const canonicalUrl = Astro.site ? new URL(templatesUrl, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, follow" />
		<meta http-equiv="refresh" content={`0; url=${templatesUrl}`} />
		<Favicons base={base} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<title>Templates — Hangwork</title>
	</head>
	<body>
		<p>
			This page is now <a href={templatesUrl}>Templates</a>.
		</p>
		<script is:inline define:vars={{ templatesUrl }}>
			window.location.replace(templatesUrl);
		</script>
	</body>
</html>
